# ---- Jev (decision model). With no key at all the app runs on MockJev (keyword rules) and shows a "mock" badge.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_PROVIDER=typesafe            # typesafe | openrouter | aimlapi | mock  (first choice; the others are fallbacks)
OPENROUTER_API_KEY=
OPENROUTER_JEV_URL=https://openrouter.ai/api/alpha/decisions
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
AIMLAPI_API_KEY=
AIMLAPI_JEV_URL=https://api.aimlapi.com/v1/decisions
AIMLAPI_JEV_MODEL=typesafe/jev
MOCK_JEV=false
JEV_BATCH_SIZE=50
JEV_CONCURRENCY=8
JEV_TURN_TIMEOUT_S=2.5
JEV_PRICE_PER_M_INPUT=0.042

# ---- ElevenLabs Agents + Twilio (see docs/ELEVENLABS_SETUP.md)
ELEVENLABS_API_KEY=
ELEVENLABS_INTAKE_AGENT_ID=
ELEVENLABS_RECALL_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=      # agent_phone_number_id of the Twilio number imported into ElevenLabs
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_WEBHOOK_ID=           # written by scripts/setup_elevenlabs.py
TOOL_SHARED_SECRET=
# Real outbound calls go ONLY to these E.164 numbers (comma-separated, e.g. +447700900123). Empty = simulated calls only.
OUTBOUND_ALLOWLIST=

# ---- Twilio: only used to import a number you ALREADY own into ElevenLabs (scripts/setup_elevenlabs.py --import-twilio)
TWILIO_ACCOUNT_SID=              # starts with AC
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=              # optional alternative: starts with SK (then TWILIO_AUTH_TOKEN is still needed for inbound)
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=             # E.164, e.g. +44...

# ---- Offline generative LLM: preprocessing only (atomise criteria, lay summaries, optional benchmark baseline)
OFFLINE_LLM_PROVIDER=anthropic   # or openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- App
PUBLIC_API_BASE_URL=             # cloudflared URL (only used in docs/setup; the agents call it)
DATABASE_URL=sqlite:///./trialready.db
MAX_DISTANCE_KM=60
K_CANDIDATES=30
DEMO_MODE=true                   # seed the 10 synthetic personas on first start
PES_MODE=screenable              # screenable | strict (literal spec formula) - see README "Deviations"
SIM_RING_SECONDS=6               # how long a simulated call rings before it auto-plays
OUTBOUND_CONCURRENCY=5
ENABLE_SCHEDULER=true            # nightly 02:00 CT.gov ingest + rematch
